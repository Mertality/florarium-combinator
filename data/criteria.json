{
  "meta": {
    "schema_version": "1.3",
    "file": "data/criteria.json",
    "purpose": "Контракт данных и правил комбинатора флорариумов. Каталог, стили, материалы, нормы, шаблоны ухода, диагностика — отдельные файлы.",
    "locale_model": "Все значения — машинные ключи. Тексты UI — i18n/ru.json + i18n/en.json. Названия видов — в карточках (name_ru, name_en, name_latin).",
    "messages": "Каждое правило обязано иметь строки rules.<id>.msg и rules.<id>.remedy в ОБОИХ словарях. Конфликты пересечений: conflict.<field>.msg.",
    "key_format": "no_trailing_spaces; имена файлов без пробелов",
    "changelog": [
      "1.3: машинные ключи вместо русских строк (карты миграции — enums.*.migrate)",
      "1.3: новые входы vessel/placement/water_type/experience/style + производные поля",
      "1.3: pH-модель зон: растения + субстрат + камни + вода пересекаются единым механизмом",
      "1.3: light остаётся массивом допусков, добавлен light_optimum; жёсткого запрета разных категорий света НЕТ",
      "1.3: substrate расширен до 5 типов (добавлен moss_acid, эпифитный сохранён)",
      "1.3: ИСПРАВЛЕН АЛГОРИТМ 1.2: layer_form, role, habitat_type убраны из пересечения — это описательные поля, а не требования к среде (пересечение по ним блокировало классические сборки: ковёр+куст+лиана, наземное+эпифит)",
      "1.3: добавлено глобальное пересечение по всей сборке (попарное не гарантирует общего)",
      "1.3: явный фильтр по system_type карточки (в 1.2 отсутствовал)",
      "1.3: удалены legacy min_volume, min_volume_display, toxicity_for_fauna; notes → i18n",
      "1.3: новые поля: slug, image, ph_tolerance, spread_mechanism, trim_interval_weeks, height_cm, styles, water_quality, monocarpic, needs_day_night_drop, wintering_months, available; фауна: starter_count, feeding_plan, needs_land_zone",
      "1.3: 27 новых правил; у всех правил msg + remedy",
      "1.3: outputs: saved_builds, share_url, ai_check (спека «промт для ии.md»), vessel_recommendation",
      "1.3: черви available=false — вне настольного формата; потолок 15 л сохранён, класс «витрина» отложен"
    ]
  },

  "enums": {
    "system_type": {
      "values": ["closed", "semi", "open"],
      "migrate": {
        "закрытая (герметичная)": "closed",
        "полузакрытая (с проветриванием)": "semi",
        "открытая": "open"
      }
    },
    "air_humidity": {
      "values": ["low", "mid", "high"],
      "ranges_pct": { "low": [40, 60], "mid": [60, 80], "high": [85, 100] },
      "migrate": {
        "низкая (40–60%)": "low",
        "умеренная (60–80%)": "mid",
        "высокая (85–100%)": "high"
      }
    },
    "soil_humidity": {
      "values": ["dry", "moist", "wet"],
      "migrate": {
        "сухая (с полной просушкой)": "dry",
        "умеренно влажная": "moist",
        "постоянно мокрая / болотная": "wet"
      }
    },
    "substrate": {
      "values": [
        "tropical",
        "epiphytic",
        "carnivore_acid",
        "succulent_mineral",
        "moss_acid"
      ],
      "migrate": {
        "легкий торфяной (тропический)": "tropical",
        "эпифитный (кора и сфагнум)": "epiphytic",
        "кислый торф (для хищников)": "carnivore_acid",
        "песчано-минеральный (для суккулентов)": "succulent_mineral"
      },
      "note": "moss_acid — новый тип; рецепты в materials.json"
    },
    "light": {
      "values": ["shade", "bright_indirect", "sun"],
      "migrate": {
        "глубокая полутень": "shade",
        "рассеянный свет": "bright_indirect",
        "яркий свет / прямое солнце": "sun"
      }
    },
    "temperature": {
      "values": ["room", "cool", "warm"],
      "ranges_c": { "room": [20, 25], "cool": [10, 18], "warm": [25, 30] },
      "migrate": {
        "комнатный (20–25 °C)": "room",
        "прохладный / с зимовкой (10–18 °C)": "cool",
        "теплый тропический (25–30 °C)": "warm"
      }
    },
    "airflow": {
      "values": ["low", "mid", "high"],
      "migrate": { "низкое": "low", "среднее": "mid", "высокое": "high" }
    },
    "climate": { "values": ["tropical", "temperate", "any"] },
    "habitat": {
      "values": ["ground", "epiphyte", "paludarium", "aquatic"],
      "migrate": {
        "наземное": "ground",
        "эпифит": "epiphyte",
        "палюдариум / болото": "paludarium",
        "аквариумное": "aquatic"
      },
      "note": "описательное поле: НЕ пересекается; проверяется правилами против тары и декора"
    },
    "condensation": {
      "values": ["yes", "no", "partial"],
      "migrate": { "да": "yes", "нет": "no", "частично": "partial" }
    },
    "growth_rate": {
      "values": ["slow", "medium", "aggressive"],
      "migrate": {
        "медленная": "slow",
        "средняя": "medium",
        "быстрая / агрессивная": "aggressive"
      }
    },
    "spread_mechanism": {
      "values": ["none", "carpet", "vine", "runners"],
      "since": "1.3"
    },
    "layer_form": {
      "values": ["carpet", "bush", "accent", "vine", "mount"],
      "migrate": {
        "почвопокровный (мох, ковер)": "carpet",
        "средний куст": "bush",
        "вертикальный акцент": "accent",
        "ампельный / лиана": "vine",
        "эпифит (на коряге/камне)": "mount"
      },
      "note": "описательное: НЕ пересекается; используется стилями и подсказками"
    },
    "size": {
      "values": ["micro", "mini", "large"],
      "migrate": {
        "микро (до 5 см)": "micro",
        "мини (5–15 см)": "mini",
        "крупный (от 15 см)": "large"
      }
    },
    "plant_toxicity": {
      "values": ["safe", "toxic_if_eaten"],
      "migrate": {
        "безопасен": "safe",
        "ядовит при поедании": "toxic_if_eaten"
      }
    },
    "care_level": {
      "values": ["easy", "medium", "expert"],
      "migrate": { "легко": "easy", "средне": "medium", "эксперт": "expert" }
    },
    "dormancy": {
      "values": ["none", "cool_winter", "dry_winter"],
      "migrate": {
        "нет": "none",
        "прохладная зимовка": "cool_winter",
        "сухая зимовка": "dry_winter"
      }
    },
    "fauna_role": {
      "values": ["cleanup", "digger", "predator", "pest"],
      "migrate": {
        "санитар-деструктор (ест плесень и опад)": "cleanup",
        "рыхлитель грунта": "digger",
        "хищник (защита от вредителей)": "predator",
        "вредитель / неконтролируемое размножение": "pest"
      },
      "note": "описательное: НЕ пересекается; правила считаются по количеству"
    },
    "plant_interest": {
      "values": ["none", "nibbles", "eats_live"],
      "migrate": {
        "не трогает (только гниль и грибки)": "none",
        "может подъедать нежные побеги и мох": "nibbles",
        "активно ест живую зелень": "eats_live"
      }
    },
    "adult_size": {
      "values": ["micro", "small", "large"],
      "migrate": {
        "микро (1–3 мм)": "micro",
        "мелкий (3–7 мм)": "small",
        "средний и крупный (от 1 см)": "large"
      }
    },
    "feeding": {
      "values": ["autonomous", "needs_feeding"],
      "migrate": {
        "автономный (хватает органики в банке)": "autonomous",
        "требует подкормки (опад, сепия, овощи)": "needs_feeding"
      }
    },
    "digging": {
      "values": ["surface", "burrowing"],
      "migrate": {
        "поверхностный (не портит слои)": "surface",
        "роющий (смешает гранит с землей)": "burrowing"
      }
    },
    "fauna_toxicity": {
      "values": ["safe", "toxic_secret"],
      "migrate": {
        "безопасен": "safe",
        "выделяет токсичный секрет при стрессе": "toxic_secret"
      }
    },
    "group": {
      "values": [
        "mosses",
        "ferns",
        "foliage",
        "vines",
        "orchids",
        "bromeliads",
        "carnivores",
        "flowering",
        "succulents",
        "micro_cleanup",
        "isopods_show",
        "other_inverts"
      ],
      "migrate": {
        "Мхи и печеночники": "mosses",
        "Папоротники и плауновидные": "ferns",
        "Декоративно-лиственные и почвопокровные": "foliage",
        "Ампельные и лианы": "vines",
        "Орхидеи": "orchids",
        "Бромелиевые и эпифиты": "bromeliads",
        "Насекомоядные растения": "carnivores",
        "Цветущие": "flowering",
        "Суккуленты и полусуккуленты": "succulents",
        "Микро-санитары": "micro_cleanup",
        "Декоративные и крупные мокрицы": "isopods_show",
        "Другие беспозвоночные": "other_inverts"
      }
    },
    "ph_zone": {
      "values": ["acid", "slightly_acid", "neutral", "alkaline"],
      "ranges": {
        "acid": [3.5, 5.5],
        "slightly_acid": [5.5, 6.5],
        "neutral": [6.5, 7.5],
        "alkaline": [7.5, 8.5]
      },
      "since": "1.3"
    },
    "water_quality": {
      "values": ["any", "soft", "distilled_only"],
      "since": "1.3"
    },
    "photo_form": {
      "values": ["wild_type", "cultivar", "illustration"],
      "since": "1.3"
    },
    "license": {
      "values": ["CC0-1.0", "CC-BY-4.0", "generated"],
      "since": "1.3"
    },
    "placement": {
      "values": [
        "north",
        "east_west",
        "south_shaded",
        "south_direct",
        "room_depth",
        "lamp_only"
      ],
      "since": "1.3",
      "note": "карта placement → доступный свет и риск перегрева — в norms.json"
    },
    "water_type": {
      "values": ["distilled", "soft", "tap_hard"],
      "since": "1.3"
    },
    "experience": { "values": ["beginner", "experienced"], "since": "1.3" },
    "vessel_shape": {
      "values": [
        "bowl",
        "jar",
        "cube",
        "bottle",
        "sphere",
        "geo_house",
        "tank"
      ],
      "since": "1.3"
    },
    "closure": {
      "values": ["sealable", "vented", "open_top", "mesh"],
      "since": "1.3"
    },
    "severity": { "values": ["block", "warning", "info"], "since": "1.3" }
  },

  "inputs": {
    "vessel": {
      "mode": {
        "type": "enum",
        "values": ["have", "choose"],
        "required": true,
        "note": "have — своя тара; choose — подбор тары под сборку (outputs.vessel_recommendation)"
      },
      "shape": { "type": "enum", "enum": "vessel_shape", "required": true },
      "dims_cm": {
        "type": "object",
        "fields": ["diameter_cm", "width_cm", "depth_cm", "height_cm"],
        "required": "по форме; либо volume_liters_label + height_cm"
      },
      "volume_liters_label": {
        "type": "number",
        "required": false,
        "note": "литры с этикетки для неправильных форм (бутыль)"
      },
      "closure": { "type": "enum", "enum": "closure", "required": true },
      "neck_diameter_cm": { "type": "number", "required": false }
    },
    "system_type": { "type": "enum", "enum": "system_type", "required": true },
    "placement": {
      "type": "enum",
      "enum": "placement",
      "required": true,
      "default": "east_west"
    },
    "water_type": {
      "type": "enum",
      "enum": "water_type",
      "required": true,
      "default": "soft"
    },
    "experience": {
      "type": "enum",
      "enum": "experience",
      "required": true,
      "default": "beginner"
    },
    "style": {
      "type": "string",
      "required": false,
      "note": "id из styles.json; фильтрует пул и включает композиционные правила"
    },
    "has_open_water": { "type": "boolean", "default": false },
    "has_wintering": { "type": "boolean", "default": false },
    "has_grow_light": {
      "type": "boolean",
      "default": false,
      "note": "авто-true при placement = lamp_only"
    }
  },

  "derived": {
    "volume_liters": "из dims по формулам norms.formulas[shape], иначе label; округление 0.1",
    "footprint_cm2": "площадь дна из dims (формулы в norms)",
    "layers_cm": "дренаж 2–4 (не более 20% высоты) + разделитель + субстрат по типу — нормы в norms.json",
    "free_height_cm": "height − слои − запас 2–3 см",
    "neck_class": "narrow при neck_diameter_cm < 8 или shape = bottle, иначе wide",
    "allowed_systems": {
      "sealable": ["closed", "semi", "open"],
      "vented": ["semi", "open"],
      "open_top": ["open"],
      "mesh": ["open"]
    },
    "light_available": "norms.placement_map[placement] → массив ключей light + overheat_risk",
    "ph_corridor": "пересечение ph_tolerance всех растений ∩ ph_zones субстрата ∩ ph_zones камней ∩ ограничение water_type",
    "light_corridor": "пересечение light всех растений; оптимумы проверяются отдельно (r_light_optimum_mismatch)",
    "substrate_candidates": "глобальное пересечение substrate растений и фауны; если >1 — выбор по стилю/биотопу или пользователем",
    "capacity_ratio": "бакетная модель по norms.planting: habit вычисляется из layer_form; для каждого бакета Σ пятно(size) × (aggressive ? 2 : 1) / (footprint × fill_factor бакета)",
    "limiting": "лимитирующие виды для генератора ухода: полив — по самому чувствительному к переливу; свет — коридор+оптимумы; температура — самое узкое окно; влажность — пересечение"
  },

  "ph_model": {
    "contributors": {
      "plants": "ph_tolerance (массив зон)",
      "substrate": "materials.substrates[].ph_zones",
      "stones": "materials.stones[].ph_zones; ph_test_required=true не исключает, а даёт warning",
      "water_type": {
        "tap_hard": ["slightly_acid", "neutral", "alkaline"],
        "soft": "все зоны",
        "distilled": "все зоны"
      }
    },
    "result": "пусто → r_ph_conflict (block) со списком виновников и альтернативами; одна зона → r_ph_narrow (warning)"
  },

