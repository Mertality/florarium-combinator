        "fields": ["min", "recommended"]
      },
      "needs_land_zone": {
        "type": "boolean",
        "required": true,
        "default": false,
        "since": "1.3"
      },
      "available": {
        "type": "boolean",
        "required": true,
        "default": true,
        "since": "1.3",
        "note": "fauna_earthworms: false"
      },
      "image": { "type": "object", "required": true, "schema": "fields.image" },
      "notes": "i18n: notes.<id>"
    },
    "image": {
      "file": {
        "type": "string",
        "required": true,
        "note": "путь img/…, без пробелов в имени"
      },
      "photo_form": { "type": "enum", "enum": "photo_form", "required": true },
      "license": { "type": "enum", "enum": "license", "required": true },
      "author": { "type": "string|null", "required": true },
      "source_url": { "type": "string|null", "required": true },
      "attribution": {
        "type": "string|null",
        "required": true,
        "note": "обязателен для CC-BY-4.0; для generated — null"
      }
    }
  },

  "volume_policy": {
    "closed": { "hard_min_liters": 2, "recommended": [3, 10] },
    "semi": { "hard_min_liters": 2, "recommended": [3, 15] },
    "open_succulents": { "hard_min_liters": 1, "recommended": [1, 5] },
    "open_tropical": { "hard_min_liters": 3, "recommended": [4, 15] },
    "desktop_max_liters": 15,
    "default_preset_liters": [3, 5],
    "sphere_min_liters": 2,
    "note": "Выше 15 л — класс «витрина», отложен. Черви скрыты (available=false): не рекомендуются для замкнутых систем."
  },

  "rules": [
    {
      "id": "r_system_type_mismatch",
      "sev": "block",
      "filter": true,
      "when": "system_type карточки не содержит выбранный тип системы"
    },
    {
      "id": "r_system_airflow_high",
      "sev": "block",
      "when": "airflow=high + closed"
    },
    {
      "id": "r_system_airflow_medium",
      "sev": "warning",
      "when": "airflow=mid + closed: нужна активная колония коллембол и периодическая вентиляция"
    },
    {
      "id": "r_condensation_closed",
      "sev": "block",
      "when": "closed + condensation != yes"
    },
    {
      "id": "r_condensation_semi",
      "sev": "block",
      "when": "semi + condensation = no"
    },
    {
      "id": "r_habitat_aquatic",
      "sev": "block",
      "when": "habitat содержит aquatic/paludarium + has_open_water=false"
    },
    {
      "id": "r_volume_plant_closed",
      "sev": "block",
      "filter": true,
      "when": "closed + volume < min_volume_closed_liters"
    },
    {
      "id": "r_volume_plant_open",
      "sev": "block",
      "filter": true,
      "when": "semi/open + volume < min_volume_open_liters"
    },
    {
      "id": "r_volume_fauna",
      "sev": "block",
      "filter": true,
      "when": "volume < fauna.min_volume_liters"
    },
    {
      "id": "r_digging_small",
      "sev": "block",
      "when": "digging=burrowing + volume < 10"
    },
    {
      "id": "r_plant_interest_large",
      "sev": "block",
      "when": "plant_interest=eats_live + volume < 10"
    },
    {
      "id": "r_plant_interest_small",
      "sev": "warning",
      "when": "plant_interest=nibbles + volume < 5"
    },
    {
      "id": "r_toxicity_plant_fauna",
      "sev": "warning",
      "when": "plant_toxicity=toxic_if_eaten + fauna.plant_interest != none"
    },
    {
      "id": "r_fauna_secret",
      "sev": "warning",
      "when": "fauna_toxicity=toxic_secret + есть другая фауна"
    },
    {
      "id": "r_climate_mix",
      "sev": "warning",
      "when": "в сборке есть temperate и tropical + has_wintering=false"
    },
    {
      "id": "r_dormancy",
      "sev": "warning",
      "when": "dormancy != none + closed + has_wintering=false"
    },
    {
      "id": "r_grow_light",
      "sev": "warning",
      "when": "requires_grow_light=true + has_grow_light=false"
    },
    {
      "id": "r_growth_aggressive",
      "sev": "warning",
      "when": "growth_rate=aggressive + volume < 5"
    },
    {
      "id": "r_multiple_aggressive",
      "sev": "warning",
      "when": "более 2 растений с growth_rate=aggressive"
    },
    {
      "id": "r_feeding_closed",
      "sev": "warning",
      "when": "feeding=needs_feeding + closed"
    },
    {
      "id": "r_fauna_pest",
      "sev": "warning",
      "when": "role содержит pest — всегда"
    },
    {
      "id": "r_multiple_predators",
      "sev": "warning",
      "when": "более 1 вида фауны с role=predator"
    },
    {
      "id": "r_global_intersection",
      "sev": "block",
      "when": "глобальное пересечение любого из полей air_humidity/soil_humidity/substrate/light/temperature по всей сборке пусто; виновники определяются попарно"
    },
    {
      "id": "r_light_optimum_mismatch",
      "sev": "warning",
      "when": "light_corridor непуст, но light_optimum кого-то вне коридора: компромиссный свет"
    },
    {
      "id": "r_no_cleanup_crew",
      "sev": "warning",
      "when": "closed/semi + нет фауны с role=cleanup: запустите коллембол за 1–2 недели до посадки"
    },
    {
      "id": "r_closed_direct_sun",
      "sev": "block",
      "when": "placement=south_direct + closed: парниковый перегрев (+10–15 °C за час)"
    },
    {
      "id": "r_semi_direct_sun",
      "sev": "warning",
      "when": "placement=south_direct + semi: притенение обязательно"
    },
    {
      "id": "r_water_distilled_required",
      "sev": "block",
      "when": "water_type=tap_hard + есть виды с water_quality=distilled_only (хищники, сфагнум)"
    },
    {
      "id": "r_water_soft_recommended",
      "sev": "warning",
      "when": "water_type=tap_hard + есть виды с water_quality=soft: налёт на стекле, засоление"
    },
    {
      "id": "r_ph_conflict",
      "sev": "block",
      "when": "ph_corridor пуст: назвать виновников (напр. мрамор + росянка), предложить alternatives из карточки камня"
    },
    {
      "id": "r_ph_narrow",
      "sev": "warning",
      "when": "ph_corridor = одна зона: узкий коридор, контроль полива и камней"
    },
    {
      "id": "r_ph_test_required",
      "sev": "warning",
      "when": "выбран камень с ph_test_required=true: уксусный тест + замачивание 3–5 дней"
    },
    {
      "id": "r_calcium_vs_acid",
      "sev": "warning",
      "when": "фауна needs_feeding + субстрат carnivore_acid/moss_acid: сепия и корм локально на кормовом столике, не в грунт"
    },
    {
      "id": "r_digging_style",
      "sev": "warning",
      "when": "digging=burrowing + стиль iwagumi_rocky/minimal_modern: роющие разрушают геометрию слоёв"
    },
    {
      "id": "r_experience",
      "sev": "warning",
      "when": "experience=beginner + есть care_level=expert: предложить замену попроще"
    },
    {
      "id": "r_narrow_neck",
      "sev": "warning",
      "when": "neck_class=narrow: посадка пинцетом, обслуживание ограничено; рекомендуем closed"
    },
    {
      "id": "r_vessel_closure",
      "sev": "block",
      "when": "system_type не входит в allowed_systems(closure): геометрический домик не бывает герметичным"
    },
    {
      "id": "r_height_overflow",
      "sev": "warning",
      "when": "пряостоячее растение: free_height < height_cm <= free_height×1.5: потребуется стрижка; лианам — info направить на фон"
    },
    {
      "id": "r_height_no_fit",
      "sev": "block",
      "when": "пряостоячее растение: height_cm > free_height×1.5: не влезет даже со стрижкой"
    },
    {
      "id": "r_overcrowding",
      "sev": "warning",
      "when": "любой бакет посадки превышает warn_above из norms.planting.buckets"
    },
    {
      "id": "r_overcrowding_hard",
      "sev": "block",
      "when": "любой бакет посадки превышает block_above из norms.planting.buckets"
    },
    {
      "id": "r_shallow",
      "sev": "block",
      "when": "free_height_cm < 8: допускаются только micro и carpet"
    },
    {
      "id": "r_open_fauna_cover",
      "sev": "warning",
      "when": "open + есть фауна: сетчатая крышка (улитки убегают, влага уходит)"
    },
    {
      "id": "r_paludarium_min",
      "sev": "warning",
      "when": "has_open_water + footprint_cm2 < 300: вода+суша слишком тесно"
    },
    {
      "id": "r_epiphyte_mount",
      "sev": "info",
      "when": "растение только-эпифит + в декоре нет коряги/камня для крепления"
    },
    {
      "id": "r_litter_feeding",
      "sev": "info",
      "when": "декор содержит опад + фауна needs_feeding: корм уже в декоре, обновлять раз в 1–2 месяца"
    },
    {
      "id": "r_monocarpic",
      "sev": "info",
      "when": "есть monocarpic=true: розетка отмирает после цветения, оставляйте детки"
    },
    {
      "id": "r_day_night_drop",
      "sev": "warning",
      "when": "needs_day_night_drop=true + closed: без перепада день/ночь кувшины не формируются"
    },
    {
      "id": "r_stone_sharp_fauna",
      "sev": "info",
      "when": "камень sharp_edges=true + есть фауна: сгладить сколы напильником"
    }
  ],

  "algorithm": {
    "constraint_multi_fields": [
      "air_humidity",
      "soil_humidity",
      "substrate",
      "light",
      "temperature"
    ],
    "descriptive_multi_fields": ["layer_form", "role", "habitat", "styles"],
    "steps": [
      "0. Нормализовать входы; из тары вычислить volume, footprint, слои, free_height, neck_class, allowed_systems; из placement — light_available и overheat_risk; применить volume_policy.",
      "1. Предфильтр каталога (невидимые отсечения): available=true; system_type содержит выбранный; объём >= min по типу системы; habitat против has_open_water; light ∩ light_available непусто; r_height_no_fit; r_shallow. Если выбран стиль — сузить пул до styles.",
      "2. Пользователь выбирает растения, фауну, камни, декор; субстрат — из substrate_candidates (авто по стилю/биотопу или выбор пользователя).",
      "3. Глобальное пересечение каждого constraint-поля по ВСЕЙ сборке. Пусто → block; виновные пары найти попарными пересечениями для адресных сообщений. Описательные поля НЕ пересекать.",
      "4. Скалярные правила карточек (condensation, airflow, dormancy, toxicity, digging, interest, feeding…).",
      "5. Правила уровня сборки: счётчики, санитары, тара, высота, вместимость, стиль, вода.",
      "6. pH-коридор: растения ∩ субстрат ∩ камни ∩ вода; пусто → block с альтернативами; камни с ph_test_required → warning.",
      "7. Агрегация: block → warning → info; каждый hit несёт rule_id, виновников (ids), i18n msg + remedy.",
      "8. Есть block → сборку нельзя финализировать; предложить замены (та же группа/ярус/стиль, совместимые параметры) — вычисляются, не хардкодятся.",
      "9. Валидная сборка → outputs: шпаргалка ухода (лимитирующие виды + care_templates), список покупок (слои × footprint + starter_count), контекстная диагностика, share_url, save-payload, ai_prompt."
    ]
  },

  "outputs": {
    "saved_builds": {
      "storage": "localStorage",
      "key": "florarium.builds.v1",
      "payload": {
        "schema_version": "1.3",
        "name": "string",
        "created_at": "ISO",
        "vessel": "inputs.vessel",
        "inputs": "все inputs",
        "items": ["id"],
        "stones": ["id"],
        "decor": ["id"],
        "substrate": "key"
      },
      "ops": ["save", "load", "delete", "export_json", "import_json"],
      "import_validation": "schema_version + существование всех id в каталоге"
    },
    "share_url": {
      "params": {
        "v": "13",
        "sys": "system_type",
        "vol": "литры",
        "shape": "vessel_shape",
        "dims": "компактно",
        "place": "placement",
        "water": "water_type",
        "exp": "experience",
        "style": "id?",
        "items": "slug,slug,…",
        "stones": "slug,…",
        "decor": "slug,…"
      },
      "restore_on_load": true,
      "copy_to_clipboard": true,
      "toast": "i18n: share.toast"
    },
    "ai_check": {
      "max_chars": 2000,
      "template": "i18n: ai.prompt",
      "include": {
        "vessel": ["volume", "system_type", "placement", "water_type"],
        "plants": [
          "name_ru",
          "name_latin",
          "layer_form",
          "growth_rate",
          "air_humidity",
          "condensation"
        ],
        "fauna": ["name_ru", "role", "plant_interest"],
        "ask": [
          "биосовместимость",
          "риск загнивания",
          "перенаселение",
          "рекомендации по грунту",
          "критические ошибки"
        ]
      },
      "targets": [
        { "id": "google", "url": "https://google.com" },
        { "id": "perplexity", "url": "https://perplexity.ai" },
        { "id": "copy_only" }
      ],
      "behavior": "сначала буфер обмена → новая вкладка URL + encodeURIComponent(prompt) → toast-подсказка «Текст скопирован, нажмите Ctrl+V если не подставилось»"
    },
    "vessel_recommendation": {
      "note": "режим choose: из желаемого набора вычислить min_volume, min_footprint, min_free_height, нужный closure → 2–3 пресета из vessels.json с обоснованием"
    },
    "care_sheet": "care_templates.json + derived.limiting",
    "diagnostics": "diagnostics.json, ранжирование причин по параметрам сборки",
    "bom": "norms.json (слои, площади посадки) × derived.footprint + starter_count фауны"
  },

  "migration": {
    "step0": "trim всех ключей и значений файлов 1.2 (везде хвостовые пробелы)",
    "enum_maps": "enums.*.migrate",
    "field_renames": {
      "toxicity_for_fauna": "plant_toxicity (растения) / fauna_toxicity (фауна)"
    },
    "dropped": ["min_volume", "min_volume_display"],
    "notes_to_i18n": "notes.<id> в оба словаря",
    "data_fixes": [
      "сфагнум, леукобриум, дикранум, политрихум: добавить carnivore_acid и moss_acid в substrate (разблокировать биотоп росянка+сфагнум)",
      "fauna_earthworms: available=false",
      "монстера: image → новая генерация (adansonii), photo_form=illustration",
      "яванский и рождественский мхи: image → генерации, photo_form=illustration (убрать BY-SA из стека)",
      "всем диким формам: photo_form=wild_type + подпись-дисклеймер; сгенерированным: illustration"
    ]
  },

  "self_check": [
    "все id и slug уникальны",
    "все enum-значения валидны, light_optimum входит в light",
    "у каждого правила есть rules.<id>.msg и rules.<id>.remedy в ru и en",
    "у каждой карточки image.file существует в /img, в именах файлов нет пробелов",
    "нет хвостовых пробелов в ключах и значениях",
    "ph_tolerance непустой у всех растений",
    "styles ссылаются на существующие id стилей",
    "доступные (available=true) виды покрывают каждый стиль и каждый ярус"
  ]
}
