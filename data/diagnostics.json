{
  "meta": {
    "schema_version": "1.0",
    "file": "data/diagnostics.json",
    "purpose": "Контекстная диагностика: симптом → причины, ранжированные по параметрам сборки → решения.",
    "locale": "Тексты — i18n diag.<symptom>.name / diag.<symptom>.cause.<n> / .fix.<n> / .prev.<n>.",
    "depends": ["criteria.json", "norms.json", "plants_fauna.json"],
    "condition_vocabulary": "идентичен care_templates.meta.condition_vocabulary",
    "ranking": "score = base_weight + сумма boost.add, где boost.when истинно; причины сортируются по score убыв., показываются топ-3",
    "note": "Белый сухой налёт ≠ плесень; это первый кейс, который комбинатор должен различать по water_type."
  },
  "symptoms": [
    {
      "id": "mold_white_fuzz", "name_key": "diag.mold_white_fuzz.name",
      "causes": [
        { "cause_key": "diag.mold_white_fuzz.cause.overwater_stagnant", "base_weight": 8, "boosts": [ { "when": { "system_in": ["closed"] }, "add": 3 }, { "when": { "no_fauna_role": ["cleanup"] }, "add": 3 } ], "fix_key": "diag.mold_white_fuzz.fix.overwater_stagnant", "prevention_key": "diag.mold_white_fuzz.prev.overwater_stagnant" },
        { "cause_key": "diag.mold_white_fuzz.cause.poor_airflow", "base_weight": 5, "boosts": [ { "when": { "system_in": ["closed"] }, "add": 2 } ], "fix_key": "diag.mold_white_fuzz.fix.poor_airflow", "prevention_key": "diag.mold_white_fuzz.prev.poor_airflow" },
        { "cause_key": "diag.mold_white_fuzz.cause.decaying_leaves", "base_weight": 4, "boosts": [ { "when": { "no_fauna_role": ["cleanup"] }, "add": 2 } ], "fix_key": "diag.mold_white_fuzz.fix.decaying_leaves", "prevention_key": "diag.mold_white_fuzz.prev.decaying_leaves" }
